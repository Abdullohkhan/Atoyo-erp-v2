generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Access control ─────────────

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  /// Permission keys (see src/auth/permissions.ts). The "owner" role implicitly has all of them.
  permissions String[]
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  passwordHash     String
  fullName         String
  phone            String?
  isActive         Boolean        @default(true)
  roleId           String
  role             Role           @relation(fields: [roleId], references: [id])
  refreshTokenHash String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  notifications    Notification[]
}

// ───────────── Catalogs ─────────────

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  unit        String   @default("dona")
  category    String   @default("other")
  price       Decimal  @default(0) @db.Decimal(18, 2)
  costPrice   Decimal  @default(0) @db.Decimal(18, 2)
  barcode     String?
  description String?
  tnvedCode   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  stock       StockBalance[]
}

model Customer {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  /// "individual" (jismoniy) | "legal" (yuridik)
  type           String   @default("individual")
  phone          String
  email          String?
  address        String?
  inn            String?
  debt           Decimal  @default(0) @db.Decimal(18, 2)
  totalPurchases Decimal  @default(0) @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  saleOrders     SaleOrder[]
  requests       Request[]
}

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  phone         String
  email         String?
  address       String?
  inn           String?
  balance       Decimal  @default(0) @db.Decimal(18, 2)
  totalSupplied Decimal  @default(0) @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
}

model Employee {
  id         String   @id @default(cuid())
  code       String   @unique
  fullName   String
  position   String
  department String
  salary     Decimal  @default(0) @db.Decimal(18, 2)
  phone      String
  email      String?
  hireDate   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  manager   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stock     StockBalance[]
}

// ───────────── Stock ─────────────

model StockBalance {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  qty         Decimal   @default(0) @db.Decimal(18, 3)
  reservedQty Decimal   @default(0) @db.Decimal(18, 3)
  costPrice   Decimal   @default(0) @db.Decimal(18, 2)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
}

model StockMovement {
  id                String   @id @default(cuid())
  number            String   @unique
  date              DateTime
  /// receipt | dispatch | transfer | writeoff | adjustment
  type              String
  fromWarehouseId   String?
  fromWarehouseName String?
  toWarehouseId     String?
  toWarehouseName   String?
  /// DocumentItem[]
  items             Json
  status            String   @default("completed")
  notes             String?
  requestId         String?
  createdById       String?
  createdAt         DateTime @default(now())
}

// ───────────── Sales / purchases / money ─────────────

model SaleOrder {
  id            String   @id @default(cuid())
  number        String   @unique
  date          DateTime
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  warehouseId   String
  warehouseName String
  items         Json
  /// draft | confirmed | completed | cancelled
  status        String   @default("draft")
  total         Decimal  @db.Decimal(18, 2)
  paid          Decimal  @default(0) @db.Decimal(18, 2)
  notes         String?
  requestId     String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  number        String   @unique
  date          DateTime
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  warehouseId   String
  warehouseName String
  items         Json
  status        String   @default("draft")
  total         Decimal  @db.Decimal(18, 2)
  paid          Decimal  @default(0) @db.Decimal(18, 2)
  notes         String?
  requestId     String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id               String   @id @default(cuid())
  number           String   @unique
  date             DateTime
  /// sale | purchase
  type             String
  orderId          String
  counterpartyId   String
  counterpartyName String
  amount           Decimal  @db.Decimal(18, 2)
  /// unpaid | partial | paid
  status           String   @default("unpaid")
  dueDate          DateTime
  createdAt        DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id               String   @id @default(cuid())
  number           String   @unique
  date             DateTime
  /// cash | card | transfer
  type             String
  /// income | expense
  direction        String
  amount           Decimal  @db.Decimal(18, 2)
  counterpartyId   String?
  counterpartyName String?
  category         String
  description      String?
  requestId        String?
  createdById      String?
  createdAt        DateTime @default(now())
}

// ───────────── CRM: requests (zayavkalar) ─────────────

enum RequestStatus {
  NEW
  CONFIGURATION
  PRICING
  REVIEW
  CUSTOMER_APPROVAL
  CONTRACT
  ADVANCE_PAYMENT
  PROCUREMENT
  PROCUREMENT_APPROVAL
  RECEIVING
  ASSEMBLY
  ACT
  DELIVERY
  COMPLETED
  CANCELLED
}

model Request {
  id           String        @id @default(cuid())
  number       String        @unique
  /// modification (o'zgartirish) | assembly (butlovchilardan yig'ish) | order (buyurtma)
  kind         String        @default("assembly")
  title        String
  description  String?
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  warehouseId  String?
  status       RequestStatus @default(NEW)
  deadline     DateTime?
  markupPct    Decimal       @default(20) @db.Decimal(6, 2)
  advancePct   Decimal       @default(30) @db.Decimal(6, 2)
  paid         Decimal       @default(0) @db.Decimal(18, 2)
  createdById  String
  assigneeId   String?
  items        RequestItem[]
  events       RequestEvent[]
  contract     Contract?
  act          Act?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

model RequestItem {
  id              String   @id @default(cuid())
  requestId       String
  request         Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId       String?
  name            String
  qty             Decimal  @db.Decimal(18, 3)
  unit            String   @default("dona")
  note            String?
  /// stock (taken from the warehouse) | purchase (must be bought / imported)
  source          String   @default("stock")
  // Declarant pricing (per unit unless noted)
  tnvedCode       String?
  purchasePrice   Decimal? @db.Decimal(18, 2)
  customsDutyPct  Decimal  @default(0) @db.Decimal(6, 2)
  vatPct          Decimal  @default(12) @db.Decimal(6, 2)
  excisePct       Decimal  @default(0) @db.Decimal(6, 2)
  customsFee      Decimal  @default(0) @db.Decimal(18, 2)
  certificateCost Decimal  @default(0) @db.Decimal(18, 2)
  labCost         Decimal  @default(0) @db.Decimal(18, 2)
  serviceFee      Decimal  @default(0) @db.Decimal(18, 2)
  logisticsCost   Decimal  @default(0) @db.Decimal(18, 2)
  unitCost        Decimal? @db.Decimal(18, 2)
  salePrice       Decimal? @db.Decimal(18, 2)
  // Procurement (actual)
  supplierId      String?
  actualPrice     Decimal? @db.Decimal(18, 2)
  actualLogistics Decimal  @default(0) @db.Decimal(18, 2)
  otherCosts      Decimal  @default(0) @db.Decimal(18, 2)
  receivedQty     Decimal  @default(0) @db.Decimal(18, 3)
  issuedQty       Decimal  @default(0) @db.Decimal(18, 3)
  sortOrder       Int      @default(0)
}

model RequestEvent {
  id         String         @id @default(cuid())
  requestId  String
  request    Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  action     String
  comment    String?
  userId     String
  userName   String
  createdAt  DateTime       @default(now())
}

model ContractTemplate {
  id        String   @id @default(cuid())
  name      String
  /// HTML with {{placeholders}}
  body      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id           String    @id @default(cuid())
  number       String    @unique
  requestId    String    @unique
  request      Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  templateId   String?
  body         String
  amount       Decimal   @db.Decimal(18, 2)
  advancePct   Decimal   @db.Decimal(6, 2)
  deadlineDays Int
  /// draft | signed
  status       String    @default("draft")
  signedAt     DateTime?
  createdAt    DateTime  @default(now())
}

model Act {
  id        String   @id @default(cuid())
  number    String   @unique
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

// ───────────── System ─────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Setting {
  key   String @id
  value Json
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
